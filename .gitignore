build/
devel/
install/
log/
.colcon/

__pycache__/
*.pyc
.venv/
.vscode/
*.swp

# Teleoperation recordings can become large and should not be committed.
recordings/

# ROS2 runtime logs and recorded datasets can be very large.
logs/
rosbag2_*/
*.db3
*.mcap

# Machine-specific first-integration reports; share them for review instead.
ubuntu_preflight_report.txt
build_report.txt
right_arm_limits.txt

# Prevent the removed upstream ROS1/simulation tree from being accidentally
# copied back into this real-robot deployment repository.
/src/
/src/simulation/mani_skill/

# Ignore editor/teacher backup copies; the canonical sources remain tracked.
servo_controller/src/*copy*.cpp
servo_controller/src/*bak*.cpp
servo_controller/src/*error*.cpp
servo_controller/launch/*copy*.py

# Intermediate objects from the vendor SDK bundle are not needed; the selected
# architecture libraries remain tracked.
servo_controller/lib/arm/*.o
